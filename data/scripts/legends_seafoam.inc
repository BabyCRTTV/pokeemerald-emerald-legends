@ Native Seafoam current scripts, using independent Emerald state.
LegendsSeafoam_Init::
	call_if_unset FLAG_LEGENDS_STORY_SEAFOAM_INITIALIZED, LegendsSeafoam_FirstVisit
	return
LegendsSeafoam_FirstVisit::
	setvar VAR_LEGENDS_SEAFOAM_ENTRY, 0
	setflag FLAG_LEGENDS_STORY_SEAFOAM_B1F_BOULDER_1
	setflag FLAG_LEGENDS_STORY_SEAFOAM_B1F_BOULDER_2
	setflag FLAG_LEGENDS_STORY_SEAFOAM_B2F_BOULDER_1
	setflag FLAG_LEGENDS_STORY_SEAFOAM_B2F_BOULDER_2
	setflag FLAG_LEGENDS_STORY_SEAFOAM_B3F_BOULDER_1
	setflag FLAG_LEGENDS_STORY_SEAFOAM_B3F_BOULDER_2
	setflag FLAG_LEGENDS_STORY_SEAFOAM_B4F_BOULDER_1
	setflag FLAG_LEGENDS_STORY_SEAFOAM_B4F_BOULDER_2
	setflag FLAG_LEGENDS_STORY_SEAFOAM_INITIALIZED
	return
